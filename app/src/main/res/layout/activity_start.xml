<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:textStyle="bold"
    android:background="#FFE0B2">


    <TextView
        android:id="@+id/txt_result"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Result"
        android:textColor="#000"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.052" />

    <TextView
        android:id="@+id/txt_p1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="P1: 0"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/txt_result"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_margin="16dp"
        android:textStyle="bold"
        android:textColor="#BF360C"/>


    <TextView
        android:id="@+id/txt_p2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="P2: 0"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/txt_p1"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_margin="16dp"
        android:textStyle="bold"
        android:textColor="#BF360C"/>

    <TextView
        android:id="@+id/txt_winner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Winner"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/txt_p2"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_margin="16dp"
        android:textColor="#D807DE43"/>

    <Button
        android:id="@+id/btn_play_again"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Play Again"
        android:backgroundTint="#FB8C00"
        android:textColor="@android:color/white"
        app:layout_constraintTop_toBottomOf="@id/txt_winner"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="24dp"/>

    <Button
        android:id="@+id/btn_leaderboard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="View Leaderboard"
        android:backgroundTint="#803333"
        android:textColor="@android:color/white"
        app:layout_constraintTop_toBottomOf="@id/btn_play_again"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>